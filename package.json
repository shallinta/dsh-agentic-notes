{
  "name": "@suiji-ai/dsh-agentic-notes",
  "version": "0.2.2",
  "type": "module",
  "description": "随记：DSH 本地笔记插件，随手记录、AI 归档、日记、待办、便笺与 MCP。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*",
    "SPEC.md",
    "README.md",
    "native-agent-loop.js",
    "native-agent-tools.js",
    "agent-service.js",
    "mcp-server.js",
    "mcp-core.js",
    "skills/*",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node --import ./test/setup.mjs --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shallinta/dsh-agentic-notes.git"
  },
  "license": "MIT",
  "author": "shallinta",
  "homepage": "https://github.com/shallinta/dsh-agentic-notes#readme",
  "bugs": {
    "url": "https://github.com/shallinta/dsh-agentic-notes/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "notes",
    "notebook",
    "diary",
    "todo",
    "mcp",
    "local-first"
  ]
}
