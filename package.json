{
  "name": "dsh-agentic-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "随记：日记、主题笔记本、快捷记录自动归档、便笺与待办。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*",
    "SPEC.md",
    "README.md",
    "native-agent-loop.js",
    "native-agent-tools.js",
    "agent-service.js",
    "mcp-server.js",
    "mcp-core.js",
    "skills/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node --import ./test/setup.mjs --test test/*.test.mjs"
  }
}
